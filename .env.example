# ==============================================================================
# CareerFit AI Backend - Environment Configuration Example
# ==============================================================================

# Server Port (Render injects this dynamically)
PORT=8080

# MySQL Database Configuration
# Local development default:
DB_URL=jdbc:mysql://localhost:3306/careerfitai?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_local_password

# Remote Managed MySQL (e.g. Aiven, PlanetScale, Railway, AWS RDS):
# DB_URL=jdbc:mysql://mysql-provider.com:3306/careerfitai?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=avnadmin
# DB_PASSWORD=your_remote_password

# Allowed CORS Origins (Comma-separated)
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500,https://careerfitai.vercel.app

# Spring Profile
SPRING_PROFILES_ACTIVE=dev
